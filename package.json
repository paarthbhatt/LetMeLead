{
  "name": "epimetheus-leads",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal, local clone of Ekos Leads for Epimetheus Red: buying-signal lead finder + LinkedIn campaign model, driven by an MCP agent interface.",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "mcp:stdio": "tsx src/mcp/stdio.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.5"
  }
}
