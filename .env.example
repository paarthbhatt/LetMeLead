# Copy to .env and edit. Never commit the real file.

# --- core ---
ENV=local
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
DOMAIN=localhost

# --- ports (host side) ---
API_PORT=8000
WEB_PORT=3000
MCP_PORT=8765
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- database / queues ---
POSTGRES_PASSWORD=letmelead
DATABASE_URL=postgresql+psycopg://letmelead:letmelead@localhost:5432/letmelead
REDIS_URL=redis://localhost:6379/0
WORKER_CONCURRENCY=2

# --- auth ---
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
# Google OAuth (optional). Authorised redirect: {API_BASE_URL}/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback
# Encrypts stored LinkedIn sessions. Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=

# --- product rules ---
FREE_LEADS_PER_TENANT=10
LEAD_PRICE_CREDITS=1
SIGNAL_MAX_AGE_DAYS=90
CREDITS_PER_PACK=100
CREDITS_PACK_PRICE_CENTS=4900

# --- LLM (optional; heuristics otherwise) ---
LLM_PROVIDER=none            # none | openai | anthropic | ollama
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- enrichment (optional) ---
ENRICHMENT_PROVIDER=pattern  # none | pattern
ENRICHMENT_API_KEY=

# --- signal sources (all optional) ---
X_BEARER_TOKEN=
GOOGLE_MAPS_API_KEY=
MAPS_QUERY=
FB_ACCESS_TOKEN=
FB_PAGE_IDS=
REVIEWS_FEED_URL=
REDDIT_ENABLED=true
DISCOVERY_PROVIDER=static     # static | llm

# --- billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- outreach safety ---
OUTREACH_ENABLED=false
OUTREACH_DRY_RUN=true
OUTREACH_MIN_SECONDS=45
OUTREACH_MAX_SECONDS=180
OUTREACH_NEW_ACCOUNT_DAILY_CAP=5
OUTREACH_MAX_DAILY_CAP=20
OUTREACH_WITHDRAW_AFTER_DAYS=21

# --- infra ---
CORS_ORIGINS=http://localhost:3000
SENTRY_DSN=
LOG_LEVEL=INFO
S3_ENDPOINT_URL=
S3_ACCESS_KEY=letmelead
S3_SECRET_KEY=letmelead-secret
S3_BUCKET=letmelead-exports
INSTALL_PLAYWRIGHT=0

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
