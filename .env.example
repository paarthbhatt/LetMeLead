# ---- Server ----
PORT=8787
# Optional shared secret for the local MCP endpoint. Leave empty for localhost-only use.
LOCAL_MCP_KEY=
DB_PATH=./data/leads.db

# ---- LLM (optional) ----
# Any OpenAI-compatible endpoint. Without this the tool falls back to heuristics.
# Used for: brief generation, AI fit-check, outreach sequence drafting.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Signal sources (all optional except public_scan + reddit) ----
# public_scan: job boards, news, tech checks (needs Python 3.9+). Always on.
# reddit: public Reddit search. Always on, best-effort/rate-limited.
# X / Twitter (X API v2 bearer token)
X_BEARER_TOKEN=
# Google Maps / Places (text search query, e.g. "AI startups, Berlin")
GOOGLE_MAPS_API_KEY=
MAPS_QUERY=
# Facebook Graph API page monitoring
FB_ACCESS_TOKEN=
FB_PAGE_IDS=
# Review sites: URL returning JSON [{company,domain,date,rating,url,summary}]
REVIEWS_FEED_URL=
# Vendored scan providers (optional)
PREDICTLEADS_API_KEY=
PREDICTLEADS_API_TOKEN=
FIRECRAWL_API_KEY=
APIFY_TOKEN=

# ---- Enrichment (optional) ----
# Without this, leads still get a LinkedIn search link; email/phone stay empty.
ENRICH_PROVIDER=
ENRICH_API_KEY=

# ---- Outreach (optional) ----
# Webhook sender: POSTs {campaign_id, lead, messages} per queued lead.
OUTREACH_WEBHOOK_URL=
# LinkedIn automation is OFF by default. Platform terms prohibit automated
# messaging and accounts get banned. Prefer the manual sender or a webhook.
ENABLE_LINKEDIN_AUTOMATION=false
