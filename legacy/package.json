{
  "name": "letmelead",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local, free buying-signal lead engine: find companies showing real buying signals, review why, enrich contacts, and run outreach. Driven by a dashboard and an MCP agent interface.",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "mcp:stdio": "tsx src/mcp/stdio.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.5"
  }
}
